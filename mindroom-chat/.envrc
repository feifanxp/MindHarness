# This repository is a GitHub fork of cinnyapp/cinny, so `gh` resolves the
# parent as the default base repo and `gh pr create` targets upstream Cinny
# unless told otherwise. Pin every gh invocation to our own repo.
#
# Local-only alternative that does not need direnv:
#   gh repo set-default mindroom-ai/mindroom-chat
export GH_REPO=mindroom-ai/mindroom-chat
