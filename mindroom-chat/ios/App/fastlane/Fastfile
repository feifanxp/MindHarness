# MindRoom iOS release lanes.
#
# Run from ios/App (all relative paths below assume that working directory):
#   bundle exec fastlane ios <lane>   # or `fastlane ios <lane>` for a Homebrew install
#
# Authentication uses an App Store Connect API key via environment variables:
#   ASC_KEY_ID       key ID (e.g. YOUR_KEY_ID)
#   ASC_ISSUER_ID    issuer ID from App Store Connect > Users and Access > Integrations
#   ASC_KEY_CONTENT  base64-encoded contents of the .p8 key, OR
#   ASC_KEY_PATH     filesystem path to the .p8 key
#
# See .docs/ios-fastlane.md for the full workflow.

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Build web assets and sync them into the iOS project (npm run build:ios + cap sync)"
  lane :sync_web do
    sh("cd ../../.. && npm run build:ios && npx cap sync ios")
  end

  desc "Build a signed release archive and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    sync_web
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "-allowProvisioningUpdates",
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload App Store metadata (name, subtitle, description, keywords, review notes) from fastlane/metadata"
  lane :upload_metadata do
    api_key = asc_api_key
    begin
      deliver(
        api_key: api_key,
        skip_screenshots: true,
        skip_binary_upload: true,
        # Skip the interactive HTML preview confirmation so the lane runs unattended.
        force: true,
      )
    ensure
      preserve_review_access(app_version: nil)
    end
  end

  desc "Upload App Store screenshots from fastlane/screenshots"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,
    )
  end

  desc "Validate and submit an existing Xcode Cloud build to App Store review with automatic release after approval"
  lane :release do |options|
    app_version = (options[:app_version] || ENV["APP_STORE_VERSION"]).to_s.strip
    build_number = (options[:build_number] || ENV["APP_STORE_BUILD_NUMBER"]).to_s.strip
    release_notes = (options[:release_notes] || ENV["APP_STORE_RELEASE_NOTES"]).to_s.strip
    confirmation = (options[:confirmation] || ENV["APP_STORE_RELEASE_CONFIRMATION"]).to_s.strip

    release_environment = {
      "APP_STORE_VERSION" => app_version,
      "APP_STORE_BUILD_NUMBER" => build_number,
      "APP_STORE_RELEASE_NOTES" => release_notes,
      "APP_STORE_RELEASE_CONFIRMATION" => confirmation,
    }
    escaped_environment = release_environment.map do |key, value|
      "#{key}=#{Shellwords.escape(value)}"
    end.join(" ")

    sh("cd ../../.. && #{escaped_environment} npm run appstore:release:preflight")
    sh("cd ../../.. && npm run appstore:preflight")
    sh("cd ../../.. && npm run typecheck")
    sh("cd ../../.. && npm test")
    sh("cd ../../.. && npm run build:ios")

    api_key = asc_api_key
    verify_release_target(
      app_version: app_version,
      build_number: build_number,
    )

    begin
      deliver(
        api_key: api_key,
        app_version: app_version,
        release_notes: { "en-US" => release_notes },
        skip_screenshots: true,
        skip_binary_upload: true,
        submit_for_review: false,
        automatic_release: true,
        precheck_include_in_app_purchases: false,
        force: true,
      )
    ensure
      preserve_review_access(app_version: app_version)
    end

    ensure_review_access(
      app_version: app_version,
      strict: true,
    )

    deliver(
      api_key: api_key,
      app_version: app_version,
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )

    deliver(
      api_key: api_key,
      app_version: app_version,
      build_number: build_number,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )

    verify_release_submission(app_version: app_version)
  end

  private_lane :asc_api_key do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    unless key_id && issuer_id
      UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID (App Store Connect API key).")
    end

    if ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true,
      )
    elsif ENV["ASC_KEY_PATH"]
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: ENV["ASC_KEY_PATH"],
      )
    else
      UI.user_error!("Set ASC_KEY_CONTENT (base64 .p8 contents) or ASC_KEY_PATH (path to the .p8 file).")
    end
  end

  private_lane :verify_release_target do |options|
    app_version = options[:app_version]
    build_number = options[:build_number]
    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find("chat.mindroom.app")
    UI.user_error!("Could not find chat.mindroom.app in App Store Connect.") unless app

    if app.get_in_progress_review_submission(platform: platform)
      UI.user_error!("Another iOS App Store review submission is already in progress.")
    end

    editable_version = app.get_edit_app_store_version(platform: platform)
    if editable_version && editable_version.version_string != app_version
      UI.user_error!(
        "Editable App Store version #{editable_version.version_string} already exists; refusing to replace it with #{app_version}."
      )
    end

    live_version = app.get_live_app_store_version(platform: platform)
    if live_version && Gem::Version.new(app_version) <= Gem::Version.new(live_version.version_string)
      UI.user_error!(
        "App Store version #{app_version} must be newer than live version #{live_version.version_string}."
      )
    end

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: app_version,
      build_number: build_number,
      platform: platform,
      limit: 5,
    ).first
    UI.user_error!("Build #{app_version} (#{build_number}) does not exist in App Store Connect.") unless build

    unless build.processing_state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Build #{app_version} (#{build_number}) is #{build.processing_state}, not VALID.")
    end
    UI.user_error!("Build #{app_version} (#{build_number}) is expired.") if build.expired
    # fastlane's predicate only accepts READY_FOR_BETA_TESTING, although a
    # build already in TestFlight is also ready for App Store submission.
    internal_state = build.build_beta_detail&.internal_build_state
    unless build.ready_for_internal_testing? ||
        internal_state == Spaceship::ConnectAPI::BuildBetaDetail::InternalState::IN_BETA_TESTING
      UI.user_error!("Build #{app_version} (#{build_number}) is not ready for testing or submission.")
    end
    if build.missing_export_compliance?
      UI.user_error!("Build #{app_version} (#{build_number}) is missing export-compliance answers.")
    end

    UI.success("Verified App Store build #{app_version} (#{build_number}).")
  end

  private_lane :ensure_review_access do |options|
    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find("chat.mindroom.app")
    UI.user_error!("Could not find chat.mindroom.app in App Store Connect.") unless app

    version = app.get_edit_app_store_version(platform: platform)
    expected_version = options[:app_version]
    if version.nil? || (expected_version && version.version_string != expected_version)
      message = expected_version ? "Could not find editable App Store version #{expected_version}." : "Could not find an editable App Store version."
      options[:strict] ? UI.user_error!(message) : UI.important(message)
      next
    end

    review = version.fetch_app_store_review_detail
    unless review
      message = "App Store version #{version.version_string} has no review information."
      options[:strict] ? UI.user_error!(message) : UI.important(message)
      next
    end

    demo_credentials_present = [review.demo_account_name, review.demo_account_password].all? do |value|
      !value.to_s.strip.empty?
    end
    if demo_credentials_present && !review.demo_account_required
      review.update(attributes: { demo_account_required: true })
      UI.success("Restored the App Store demo-account requirement.")
    end

    required_fields = {
      "contact first name" => review.contact_first_name,
      "contact last name" => review.contact_last_name,
      "contact phone" => review.contact_phone,
      "contact email" => review.contact_email,
      "demo account name" => review.demo_account_name,
      "demo account password" => review.demo_account_password,
      "review notes" => review.notes,
    }
    missing_fields = required_fields.select { |_name, value| value.to_s.strip.empty? }.keys
    unless missing_fields.empty?
      message = "App Store review information is missing: #{missing_fields.join(', ')}."
      options[:strict] ? UI.user_error!(message) : UI.important(message)
      next
    end
  end

  private_lane :preserve_review_access do |options|
    begin
      ensure_review_access(
        app_version: options[:app_version],
        strict: false,
      )
    rescue => error
      UI.important(
        "Could not restore the App Store demo-account requirement after metadata upload: #{error.message}"
      )
    end
  end

  private_lane :verify_release_submission do |options|
    app_version = options[:app_version]
    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find("chat.mindroom.app")
    UI.user_error!("Could not find chat.mindroom.app in App Store Connect.") unless app

    poll_attempts_value = ENV.fetch("APP_STORE_REVIEW_POLL_ATTEMPTS", "24")
    poll_interval_value = ENV.fetch("APP_STORE_REVIEW_POLL_INTERVAL_SECONDS", "10")
    unless poll_attempts_value.match?(/\A[1-9][0-9]*\z/) && poll_interval_value.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!(
        "APP_STORE_REVIEW_POLL_ATTEMPTS and APP_STORE_REVIEW_POLL_INTERVAL_SECONDS must be positive integers."
      )
    end
    poll_attempts = poll_attempts_value.to_i
    poll_interval = poll_interval_value.to_i

    accepted_states = [
      Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::WAITING_FOR_REVIEW,
      Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::IN_REVIEW,
    ]
    version = nil
    submission = nil

    poll_attempts.times do |attempt|
      version = app.get_edit_app_store_version(platform: platform)
      submission = app.get_in_progress_review_submission(platform: platform)
      break if version&.version_string == app_version && accepted_states.include?(submission&.state)

      if attempt < poll_attempts - 1
        UI.message("Waiting for App Store Connect to confirm the review submission...")
        sleep(poll_interval)
      end
    end

    unless version&.version_string == app_version && accepted_states.include?(submission&.state)
      UI.user_error!("App Store Connect did not confirm #{app_version} as submitted for review.")
    end
    unless version.release_type == Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
      UI.user_error!("App Store version #{app_version} is not configured for automatic release after approval.")
    end

    UI.success(
      "App Store version #{app_version} is #{submission.state} with automatic release after approval."
    )
  end
end
