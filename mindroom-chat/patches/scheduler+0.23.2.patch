--- /dev/null
+++ b/node_modules/scheduler/cjs/mindroom-wakeup.js
@@ -0,0 +1,78 @@
+'use strict';
+
+// MindRoom: WebKit brokers MessagePorts through its networking process, and
+// when that process exits existing ports silently stop delivering. A lost
+// wakeup would leave Scheduler's isMessageLoopRunning set forever, so replace
+// a channel whose wakeup has not arrived after a timer-driven grace period.
+// Both Scheduler builds use this module so their recovery cannot drift.
+var WAKEUP_TIMEOUT_MS = 250;
+var WAKEUP_REPLACED_EVENT = 'mindroom:scheduler-wakeup-replaced';
+
+function notifyWakeupReplaced(elapsedMs) {
+  try {
+    dispatchEvent(new CustomEvent(WAKEUP_REPLACED_EVENT, { detail: { elapsedMs: elapsedMs } }));
+  } catch (error) {
+    // Diagnostics must not affect scheduling, including where the DOM event API is missing.
+  }
+}
+
+module.exports = function createWakeupScheduler(performWork, setTimer, now) {
+  var receiver = null;
+  var port = null;
+  var pending = false;
+  var postedAt = -1;
+  var watchdogID = -1;
+
+  function receiveWakeup() {
+    pending = false;
+    performWork();
+  }
+
+  function connectWakeupPort() {
+    // A listening port stays alive in WebKit, and a merely delayed wakeup has
+    // been posted again, so close the replaced pair.
+    if (receiver !== null) {
+      receiver.close();
+      port.close();
+    }
+
+    var channel = new MessageChannel();
+    channel.port1.onmessage = receiveWakeup;
+    receiver = channel.port1;
+    port = channel.port2;
+  }
+
+  function armWatchdog(ms) {
+    if (watchdogID === -1) watchdogID = setTimer(checkWakeup, ms);
+  }
+
+  function postWakeup(reconnect) {
+    postedAt = now();
+    // Arm first so a failing port operation still retries.
+    armWatchdog(WAKEUP_TIMEOUT_MS);
+    if (reconnect) connectWakeupPort();
+    port.postMessage(null);
+  }
+
+  function checkWakeup() {
+    watchdogID = -1;
+    if (!pending) return;
+    var elapsed = now() - postedAt;
+
+    if (elapsed < WAKEUP_TIMEOUT_MS) {
+      armWatchdog(WAKEUP_TIMEOUT_MS - elapsed);
+      return;
+    }
+
+    postWakeup(true);
+    notifyWakeupReplaced(elapsed);
+  }
+
+  connectWakeupPort();
+
+  return function schedulePerformWorkUntilDeadline() {
+    if (pending) return;
+    pending = true;
+    postWakeup(false);
+  };
+};
